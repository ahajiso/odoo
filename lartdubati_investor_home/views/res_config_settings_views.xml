<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_stock_monitor" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.stock.monitor</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Stock Monitor" name="stock_monitor_setting_container">
                    <setting string="Currency Conversion"
                             help="How amounts are converted into the currency of a stock located in another country.">
                        <field name="stock_monitor_currency_mode"/>
                        <div class="text-muted">
                            Latest Rate: today's rate. Rate on Entry Date: the rate of the day the
                            item entered the stock. No Conversion: everything in the company currency.
                        </div>
                    </setting>
                    <setting string="Replacement Price"
                             help="Inventory value of borrowed or rented consumables.">
                        <field name="stock_monitor_replacement_price"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
