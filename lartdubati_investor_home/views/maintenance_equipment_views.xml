<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_form_investor" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.investor</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance_shareholder_equipment.view_maintenance_equipment_form_shareholder"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='acquisition_mode']" position="after">
                <field name="ownership"/>
                <field name="rent_currency_id" invisible="1"/>
                <field name="rent_amount" invisible="ownership != 'rented'"/>
                <field name="rent_period" invisible="ownership != 'rented'"/>
                <field name="rent_start_date" invisible="ownership != 'rented'"/>
            </xpath>
        </field>
    </record>
</odoo>
