<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_stock_access" model="ir.ui.view">
        <field name="name">res.users.form.stock.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page string="Stock Access" name="stock_access" groups="base.group_erp_manager">
                    <group>
                        <field name="stock_access_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
