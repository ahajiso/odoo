<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_access_list" model="ir.ui.view">
        <field name="name">lartdubati.stock.access.list</field>
        <field name="model">lartdubati.stock.access</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="country_ids" widget="many2many_tags"/>
                <field name="location_ids" widget="many2many_tags"/>
                <field name="ownership_type_ids" widget="many2many_tags"/>
                <field name="family_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_stock_access_form" model="ir.ui.view">
        <field name="name">lartdubati.stock.access.form</field>
        <field name="model">lartdubati.stock.access</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Investor - France"/></h1>
                    </div>
                    <p class="text-muted">An empty list means no restriction on that criterion.</p>
                    <group>
                        <field name="country_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="location_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="ownership_type_ids" widget="many2many_checkboxes"/>
                        <field name="family_ids" widget="many2many_checkboxes"/>
                    </group>
                    <group string="Users">
                        <field name="user_ids" nolabel="1" colspan="2" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="login"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_access" model="ir.actions.act_window">
        <field name="name">Stock Access Profiles</field>
        <field name="res_model">lartdubati.stock.access</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_stock_access"
              action="action_stock_access"
              parent="base.menu_users"
              groups="base.group_erp_manager"
              sequence="20"/>
</odoo>
