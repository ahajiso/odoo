<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Own category: the group shows as a tick box on the user form. -->
    <record id="module_category_investor" model="ir.module.category">
        <field name="name">Investor</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_stock_investor" model="res.groups">
        <field name="name">Stock Monitor Investor</field>
        <field name="category_id" ref="module_category_investor"/>
        <field name="comment">Stock access restricted by the user's Stock Access Profile.</field>
    </record>

    <!-- Global rules (no groups): Odoo ORs group rules, so a group rule could be
         widened by another group. Non-members get an always-true domain. -->
    <record id="rule_location_stock_access" model="ir.rule">
        <field name="name">Locations: stock access profile</field>
        <field name="model_id" ref="stock.model_stock_location"/>
        <field name="domain_force">user.stock_access_rule_domain('location')</field>
    </record>
    <record id="rule_stock_monitor_access" model="ir.rule">
        <field name="name">Stock monitor: stock access profile</field>
        <field name="model_id" ref="model_lartdubati_stock_monitor"/>
        <field name="domain_force">user.stock_access_rule_domain('monitor')</field>
    </record>
    <!-- Multi-company (global, ANDed with the profile rule): only the rows of the
         user's active companies, for every user. -->
    <record id="rule_stock_monitor_company" model="ir.rule">
        <field name="name">Stock monitor: multi-company</field>
        <field name="model_id" ref="model_lartdubati_stock_monitor"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- Move lines: no access for an investor without Inventory rights (all modes) -->
    <record id="rule_stock_move_line_investor" model="ir.rule">
        <field name="name">Move lines: investor without Inventory rights</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="domain_force">user.stock_access_rule_domain('move_line')</field>
    </record>

    <!-- Phase 4 (docs/phase4/PLAN.md §2, P4-2b): the few models an investor account may
         read (the others are refused by the default deny), narrowed to its own records.
         Global rules computed per user: TRUE for every other user. -->
    <record id="rule_menu_investor" model="ir.rule">
        <field name="name">Menus: investor accounts see the stock monitor only</field>
        <field name="model_id" ref="base.model_ir_ui_menu"/>
        <field name="domain_force">user.stock_access_rule_domain('menu')</field>
    </record>
    <record id="rule_quick_start_screen_investor" model="ir.rule">
        <field name="name">Quick start screens: investor accounts read the investor home</field>
        <field name="model_id" ref="web_quick_start_screen.model_quick_start_screen"/>
        <field name="domain_force">user.stock_access_rule_domain('home_screen')</field>
    </record>
    <record id="rule_quick_start_action_investor" model="ir.rule">
        <field name="name">Quick start buttons: investor accounts read the investor buttons</field>
        <field name="model_id" ref="web_quick_start_screen.model_quick_start_screen_action"/>
        <field name="domain_force">user.stock_access_rule_domain('home_button')</field>
    </record>
    <record id="rule_users_investor" model="ir.rule">
        <field name="name">Users: investor accounts read their own user</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="domain_force">user.stock_access_rule_domain('user')</field>
    </record>
    <record id="rule_partner_investor" model="ir.rule">
        <field name="name">Contacts: investor accounts read their own and the company's</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">user.stock_access_rule_domain('partner')</field>
    </record>
    <record id="rule_users_settings_investor" model="ir.rule">
        <field name="name">User settings: investor accounts use their own</field>
        <field name="model_id" ref="base.model_res_users_settings"/>
        <field name="domain_force">user.stock_access_rule_domain('users_settings')</field>
    </record>
    <record id="rule_discuss_channel_investor" model="ir.rule">
        <field name="name">Discussion channels: none for investor accounts</field>
        <field name="model_id" ref="mail.model_discuss_channel"/>
        <field name="domain_force">user.stock_access_rule_domain('none')</field>
    </record>
    <record id="rule_discuss_channel_member_investor" model="ir.rule">
        <field name="name">Channel members: none for investor accounts</field>
        <field name="model_id" ref="mail.model_discuss_channel_member"/>
        <field name="domain_force">user.stock_access_rule_domain('none')</field>
    </record>
    <record id="rule_filters_investor" model="ir.rule">
        <field name="name">Favourite filters: none for investor accounts</field>
        <field name="model_id" ref="base.model_ir_filters"/>
        <field name="domain_force">user.stock_access_rule_domain('none')</field>
    </record>
    <record id="rule_mail_message_investor" model="ir.rule">
        <field name="name">Messages: none for investor accounts</field>
        <field name="model_id" ref="mail.model_mail_message"/>
        <field name="domain_force">user.stock_access_rule_domain('none')</field>
    </record>
    <record id="rule_mail_activity_investor" model="ir.rule">
        <field name="name">Activities: none for investor accounts</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="domain_force">user.stock_access_rule_domain('none')</field>
    </record>
    <!-- own password change (audit of 6063db1): the wizard and the password check -->
    <record id="rule_change_password_own_investor" model="ir.rule">
        <field name="name">Password change: investor accounts use their own wizard</field>
        <field name="model_id" ref="base.model_change_password_own"/>
        <field name="domain_force">user.stock_access_rule_domain('own_created')</field>
    </record>
    <record id="rule_identitycheck_investor" model="ir.rule">
        <field name="name">Password check: investor accounts use their own</field>
        <field name="model_id" ref="base.model_res_users_identitycheck"/>
        <field name="domain_force">user.stock_access_rule_domain('own_created')</field>
    </record>
    <!-- own online status, written by the websocket (audit of 2071e6e) -->
    <record id="rule_bus_presence_investor" model="ir.rule">
        <field name="name">Presence: investor accounts use their own</field>
        <field name="model_id" ref="bus.model_bus_presence"/>
        <field name="domain_force">user.stock_access_rule_domain('own_presence')</field>
    </record>
    <record id="rule_mail_guest_investor" model="ir.rule">
        <field name="name">Guests: none for investor accounts</field>
        <field name="model_id" ref="mail.model_mail_guest"/>
        <field name="domain_force">user.stock_access_rule_domain('none')</field>
    </record>
</odoo>
