<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Own category: the group shows as a tick box on the user form. -->
    <record id="module_category_investor" model="ir.module.category">
        <field name="name">Investor</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_stock_investor" model="res.groups">
        <field name="name">Stock Monitor Investor</field>
        <field name="category_id" ref="module_category_investor"/>
        <field name="comment">Stock access restricted by the user's Stock Access Profile.</field>
    </record>

    <!-- Global rules (no groups): Odoo ORs group rules, so a group rule could be
         widened by another group. Non-members get an always-true domain. -->
    <record id="rule_location_stock_access" model="ir.rule">
        <field name="name">Locations: stock access profile</field>
        <field name="model_id" ref="stock.model_stock_location"/>
        <field name="domain_force">user.stock_access_rule_domain('location')</field>
    </record>
    <!-- Move lines: no access for an investor without Inventory rights (all modes) -->
    <record id="rule_stock_move_line_investor" model="ir.rule">
        <field name="name">Move lines: investor without Inventory rights</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="domain_force">user.stock_access_rule_domain('move_line')</field>
    </record>
</odoo>
