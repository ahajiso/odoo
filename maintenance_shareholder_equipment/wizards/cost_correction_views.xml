<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_cost_correction_form" model="ir.ui.view">
        <field name="name">equipment.cost.correction.form</field>
        <field name="model">equipment.cost.correction</field>
        <field name="arch" type="xml">
            <form string="Correct Cost">
                <group>
                    <field name="equipment_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="cost_known"/>
                    <field name="cost" widget="monetary" options="{'currency_field': 'currency_id'}"
                           invisible="not cost_known"/>
                    <field name="cost_date" invisible="not cost_known"/>
                    <field name="cost_provisional" invisible="not cost_known"/>
                    <field name="reason" placeholder="Why the cost is corrected"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Correct" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_equipment_cost_correction" model="ir.actions.act_window">
        <field name="name">Correct Cost</field>
        <field name="res_model">equipment.cost.correction</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
        <field name="context">{'default_equipment_id': active_id}</field>
    </record>
</odoo>
