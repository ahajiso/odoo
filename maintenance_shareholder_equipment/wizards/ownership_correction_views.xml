<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_ownership_correction_form" model="ir.ui.view">
        <field name="name">equipment.ownership.correction.form</field>
        <field name="model">equipment.ownership.correction</field>
        <field name="arch" type="xml">
            <form string="Correct Ownership">
                <group>
                    <field name="equipment_id"/>
                    <field name="ownership_status"/>
                    <field name="owner_partner_id"/>
                    <field name="reason" placeholder="Why the ownership is corrected"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Correct" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_equipment_ownership_correction" model="ir.actions.act_window">
        <field name="name">Correct Ownership</field>
        <field name="res_model">equipment.ownership.correction</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('group_equipment_ownership_manager'))]"/>
        <field name="context">{
            'default_equipment_id': active_id,
        }</field>
    </record>
</odoo>
