<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Only members can correct the ownership of an equipment (wizard with a reason).
         Nobody writes the protected fields directly: see maintenance.equipment.write(). -->
    <record id="group_equipment_ownership_manager" model="res.groups">
        <field name="name">Equipment Ownership Manager</field>
        <field name="category_id" ref="base.module_category_manufacturing_maintenance"/>
        <field name="implied_ids" eval="[(4, ref('maintenance.group_equipment_manager'))]"/>
        <field name="comment">Can correct the ownership status and the legal owner of an equipment, with a mandatory reason.</field>
    </record>

    <!-- Phase 2: equipment operations (docs/phase2/PLAN.md, section 7).
         Each group has its own category: Odoo shows a category as a drop-down list in
         the user form only when its groups form a single chain; the two roles are
         independent (the approver does not imply the operator), so sharing a category
         (or the Maintenance one) would turn it into check boxes visible only in
         developer mode. -->
    <record id="module_category_equipment_operation_execution" model="ir.module.category">
        <field name="name">Equipment Operations — Execution</field>
        <field name="parent_id" ref="base.module_category_manufacturing"/>
        <field name="sequence">60</field>
    </record>
    <record id="module_category_equipment_operation_approval" model="ir.module.category">
        <field name="name">Equipment Operations — Approval</field>
        <field name="parent_id" ref="base.module_category_manufacturing"/>
        <field name="sequence">61</field>
    </record>
    <record id="group_equipment_operator" model="res.groups">
        <field name="name">Equipment Operator</field>
        <field name="category_id" ref="module_category_equipment_operation_execution"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Prepares and executes equipment operations (receipt, exit, return, restitution). Commitments need an approver.</field>
    </record>
    <record id="group_equipment_approver" model="res.groups">
        <field name="name">Equipment Operations Approver</field>
        <field name="category_id" ref="module_category_equipment_operation_approval"/>
        <field name="comment">Approves the commitments of equipment operations (orders, bills, contracts, acquisitions), without moving stock.</field>
    </record>

    <record id="rule_equipment_operation_company" model="ir.rule">
        <field name="name">Equipment operation: multi-company</field>
        <field name="model_id" ref="model_equipment_operation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_equipment_operation_stop_company" model="ir.rule">
        <field name="name">Equipment operation contract line to stop: multi-company</field>
        <field name="model_id" ref="model_equipment_operation_stop"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_equipment_operation_line_company" model="ir.rule">
        <field name="name">Equipment operation line: multi-company</field>
        <field name="model_id" ref="model_equipment_operation_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Operators and approvers choose and check any equipment of their companies (the
         standard rule only shows the equipment a user follows). Read only. -->
    <record id="rule_equipment_read_operation_users" model="ir.rule">
        <field name="name">Equipment: read by equipment operators, approvers and accounting administrators</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <!-- accounting administrators correct equipment costs (phase 2f, D7) -->
        <field name="groups" eval="[(4, ref('group_equipment_operator')), (4, ref('group_equipment_approver')), (4, ref('account.group_account_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Phase 2f (D8): an approver without any other right on these models reads only
         the documents equipment operations refer to. Global rules (no groups): group
         rules would be ORed with other groups; for every other user the domain is
         always true (res.users._equipment_approver_domain). -->
    <record id="rule_approver_scope_purchase_order" model="ir.rule">
        <field name="name">Purchase orders: equipment approver scope</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">user._equipment_approver_domain('purchase.order')</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_approver_scope_purchase_order_line" model="ir.rule">
        <field name="name">Purchase order lines: equipment approver scope</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="domain_force">user._equipment_approver_domain('purchase.order.line')</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_approver_scope_stock_picking" model="ir.rule">
        <field name="name">Transfers: equipment approver scope</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="domain_force">user._equipment_approver_domain('stock.picking')</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_approver_scope_stock_move" model="ir.rule">
        <field name="name">Stock moves: equipment approver scope</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="domain_force">user._equipment_approver_domain('stock.move')</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_approver_scope_stock_lot" model="ir.rule">
        <field name="name">Serial numbers: equipment approver scope</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="domain_force">user._equipment_approver_domain('stock.lot')</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_approver_scope_contract_contract" model="ir.rule">
        <field name="name">Contracts: equipment approver scope</field>
        <field name="model_id" ref="contract.model_contract_contract"/>
        <field name="domain_force">user._equipment_approver_domain('contract.contract')</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_approver_scope_contract_line" model="ir.rule">
        <field name="name">Contract lines: equipment approver scope</field>
        <field name="model_id" ref="contract.model_contract_line"/>
        <field name="domain_force">user._equipment_approver_domain('contract.line')</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_approver_scope_account_move_line" model="ir.rule">
        <field name="name">Bill lines: equipment approver scope</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">user._equipment_approver_domain('account.move.line')</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <!-- Move lines: standard stock gives every internal user read, write, create and
         delete on all of them. The approver alone reads those of the operations and
         writes none; users with Inventory rights keep the standard rights. -->
    <record id="rule_approver_scope_stock_move_line" model="ir.rule">
        <field name="name">Move lines: equipment approver scope</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="domain_force">user._equipment_approver_domain('stock.move.line')</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_approver_no_write_stock_move_line" model="ir.rule">
        <field name="name">Move lines: equipment approver writes nothing</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="domain_force">user._equipment_approver_domain('stock.move.line', 'write')</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_approver_scope_contract_modification" model="ir.rule">
        <field name="name">Contract modifications: equipment approver scope</field>
        <field name="model_id" ref="contract.model_contract_modification"/>
        <field name="domain_force">user._equipment_approver_domain('contract.modification')</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_approver_scope_account_journal" model="ir.rule">
        <field name="name">Journals: equipment approver scope</field>
        <field name="model_id" ref="account.model_account_journal"/>
        <field name="domain_force">user._equipment_approver_domain('account.journal')</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_approver_scope_account_move" model="ir.rule">
        <field name="name">Bills: equipment approver scope</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">user._equipment_approver_domain('account.move')</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
