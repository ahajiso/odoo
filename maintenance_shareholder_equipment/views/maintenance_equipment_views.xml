<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_equipment_form_shareholder" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.ownership</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_finalize_integration" type="object" string="Integrate"
                            class="btn-primary" invisible="integration_state != 'draft'"
                            groups="maintenance.group_equipment_manager"/>
                    <button name="%(action_equipment_ownership_correction)d" type="action"
                            string="Correct Ownership"
                            groups="maintenance_shareholder_equipment.group_equipment_ownership_manager"/>
                    <field name="integration_state" widget="statusbar"/>
                </header>
            </xpath>
            <field name="owner_user_id" position="attributes">
                <attribute name="string">Responsible / Holder</attribute>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Ownership and Stock" name="ownership">
                    <group>
                        <group string="Ownership">
                            <field name="ownership_status"/>
                            <field name="owner_partner_id"/>
                            <field name="handover_value" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            <field name="handover_value_date"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                        <group string="Stock and Asset">
                            <field name="stock_lot_id"
                                   domain="[('product_id', '=', product_id)]"/>
                            <field name="current_location_id" invisible="stock_lot_id"/>
                            <field name="asset_id"/>
                            <field name="move_line_id" readonly="1"/>
                        </group>
                        <group string="Replacement Value">
                            <field name="replacement_value" widget="monetary" options="{'currency_field': 'replacement_currency_id'}"/>
                            <field name="replacement_currency_id"/>
                            <field name="replacement_value_date"/>
                        </group>
                        <group string="Warranty and Insurance">
                            <field name="warranty_status"/>
                            <field name="insurance_status"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_maintenance_equipment_search_integration" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.integration</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="to_complete" string="To Complete"
                        domain="[('integration_state', '=', 'draft')]"/>
                <filter name="group_ownership" string="Ownership Status"
                        context="{'group_by': 'ownership_status'}"/>
            </xpath>
        </field>
    </record>
</odoo>
