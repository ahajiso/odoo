<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_contract_line" model="ir.ui.view">
        <field name="name">account.move.form.contract.line</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']" position="after">
                <field name="contract_line_id" optional="show"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"
                       domain="[('contract_id.contract_type', '=', 'purchase'),
                                ('contract_id.partner_id', 'child_of', parent.commercial_partner_id),
                                ('contract_id.company_id', '=', parent.company_id),
                                ('equipment_nature', '=', 'rental')]"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
