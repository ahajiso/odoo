<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_request_form_repair_cost" model="ir.ui.view">
        <field name="name">maintenance.request.form.repair.cost</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Repair Cost">
                    <field name="repair_cost"/>
                    <field name="repairer"/>
                    <field name="repair_invoice_ref"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
