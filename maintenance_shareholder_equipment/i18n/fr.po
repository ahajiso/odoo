msgstr ""
"%(line)s : le traitement comptable prévu a changé (%(before)s → %(now)s)"

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/equipment_operation.py:0
msgid ""
"%(line)s: the product %(product)s has no default equipment category. The "
"catalogue manager sets it (structural correction) before the receipt."
msgstr ""
"%(line)s : le produit %(product)s n'a pas de catégorie d'équipement par "
"défaut. Le gestionnaire du catalogue la renseigne (correction structurelle) "
"avant la réception."

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/account_move.py:0
msgid ""
"%(move)s: the product %(product)s has no default equipment category. The "
"catalogue manager sets it (structural correction) before the bill is posted."
msgstr ""
"%(move)s : le produit %(product)s n'a pas de catégorie d'équipement par "
"défaut. Le gestionnaire du catalogue la renseigne (correction structurelle) "
"avant la comptabilisation de la facture."

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/maintenance_equipment.py:0
