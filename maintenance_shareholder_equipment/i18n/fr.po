#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/contract.py:0
msgid ""
"%(equipment)s already has a %(nature)s line from %(start)s to %(end)s "
"(%(contract)s)."
msgstr ""
"%(equipment)s a déjà une ligne %(nature)s du %(start)s au %(end)s "
"(%(contract)s)."

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/equipment_operation.py:0
msgid ""
"%(equipment)s: a %(nature)s line runs until %(end)s; start the new one on "
"%(next)s or later."
msgstr ""
"%(equipment)s : une ligne %(nature)s court jusqu'au %(end)s ; faites "
"commencer la nouvelle le %(next)s ou après."

#. module: maintenance_shareholder_equipment
