#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/contract.py:0
msgid ""
"%(equipment)s already has a %(nature)s line from %(start)s to %(end)s "
"(%(contract)s)."
msgstr ""
"%(equipment)s از قبل یک سطر %(nature)s از %(start)s تا %(end)s دارد "
"(%(contract)s)."

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/maintenance_equipment.py:0
msgid "%(name)s cannot be integrated, missing: %(missing)s"
msgstr "%(name)s را نمی‌توان یکپارچه کرد، موارد ناقص: %(missing)s"

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/stock.py:0
msgid "%(name)s cannot be its own return location."
msgstr "%(name)s نمی‌تواند مکان بازگشت خودش باشد."

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/maintenance_equipment.py:0
msgid ""
"%(name)s has a serial number in stock: its location comes from the stock, "
"the non-stock location must stay empty."
msgstr ""
"%(name)s شماره سریال در انبار دارد: مکان آن از انبار گرفته می‌شود و مکان "
"خارج از انبار باید خالی بماند."

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/stock.py:0
msgid "%(name)s is a lent-out stock: its return location is required."
msgstr "%(name)s انبار نزد شخص ثالث است: مکان بازگشت آن الزامی است."

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/maintenance_equipment.py:0
msgid "%(name)s is already linked to another supplier bill line."
msgstr "%(name)s از قبل به سطر دیگری از صورتحساب تأمین‌کننده پیوند دارد."

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/product.py:0
msgid ""
"%(name)s is an equipment or a fixed asset kept in stock: it must be tracked "
"by unique serial number."
msgstr ""
"%(name)s تجهیز یا دارایی ثابتی است که در انبار نگهداری می‌شود: باید با شماره"
" سریال یکتا ردیابی شود."

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/maintenance_equipment.py:0
msgid "%(name)s is integrated and must keep: %(missing)s"
msgstr "%(name)s یکپارچه شده است و باید این موارد را حفظ کند: %(missing)s"

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/maintenance_equipment.py:0
msgid "%(name)s: a borrowed or rented item belongs to a third party."
msgstr "%(name)s: کالای امانی یا اجاره‌ای متعلق به شخص ثالث است."

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/maintenance_equipment.py:0
msgid "%(name)s: an owned or lent-out item belongs to the company."
msgstr ""
"%(name)s: کالای متعلق به شرکت یا سپرده‌شده نزد شخص ثالث متعلق به شرکت است."

