#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/stock.py:0
msgid ""
"%(product)s %(lot)s: an owner other than the company is only allowed for a "
"serial number of a borrowed or rented equipment of that owner (%(owner)s)."
msgstr ""
"%(product)s %(lot)s: مالکی غیر از شرکت فقط برای شماره سریال تجهیز امانی یا "
"اجاره‌ای از همان مالک (%(owner)s) مجاز است."

#. module: maintenance_shareholder_equipment
#: model:ir.model.constraint,message:maintenance_shareholder_equipment.constraint_maintenance_equipment_asset_uniq
msgid "A fixed asset can belong to one equipment only."
msgstr "یک دارایی ثابت فقط می‌تواند به یک تجهیز تعلق داشته باشد."

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/maintenance_equipment.py:0
