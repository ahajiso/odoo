"%(name)s: the owner on stock (%(stock_owner)s) does not match the ownership "
"(%(status)s)."
msgstr ""
"%(name)s: مالک در انبار (%(stock_owner)s) با وضعیت مالکیت (%(status)s) "
"مطابقت ندارد."

#. module: maintenance_shareholder_equipment
#. odoo-python
#: code:addons/maintenance_shareholder_equipment/models/stock.py:0
