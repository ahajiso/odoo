#: model:ir.model.constraint,message:maintenance_shareholder_equipment.constraint_maintenance_equipment_stock_lot_uniq
msgid "A serial number can belong to one equipment only."
msgstr "یک شماره سریال فقط می‌تواند به یک تجهیز تعلق داشته باشد."

