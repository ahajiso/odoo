<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Conditions de paiement usuelles en BTP.
            noupdate="1" : ces enregistrements ne sont créés qu'une fois, les
            modifications faites ensuite dans l'interface sont conservées.

            Rappel légal (art. L.441-10 du Code de commerce) : entre
            professionnels, le délai de paiement ne peut dépasser 60 jours à
            compter de la date de facture, ou 45 jours fin de mois si cette
            dérogation est expressément prévue au contrat.
        -->

        <record id="payment_term_comptant" model="account.payment.term">
            <field name="name">Comptant à réception de facture</field>
            <field name="sequence">5</field>
            <field name="note">Paiement à réception de la facture.</field>
            <field name="line_ids" eval="[(5, 0, 0), (0, 0, {
                'value': 'percent',
                'value_amount': 100.0,
                'delay_type': 'days_after',
                'nb_days': 0,
            })]"/>
        </record>

        <record id="payment_term_30j" model="account.payment.term">
            <field name="name">30 jours date de facture</field>
            <field name="sequence">10</field>
            <field name="note">Paiement à 30 jours à compter de la date de facture.</field>
            <field name="line_ids" eval="[(5, 0, 0), (0, 0, {
                'value': 'percent',
                'value_amount': 100.0,
                'delay_type': 'days_after',
                'nb_days': 30,
            })]"/>
        </record>

        <record id="payment_term_45j_fdm" model="account.payment.term">
            <field name="name">45 jours fin de mois</field>
            <field name="sequence">15</field>
            <field name="note">Paiement à 45 jours fin de mois. Ce délai dérogatoire
                doit être expressément prévu au contrat (art. L.441-10 du Code de
                commerce).</field>
            <field name="line_ids" eval="[(5, 0, 0), (0, 0, {
                'value': 'percent',
                'value_amount': 100.0,
                'delay_type': 'days_after_end_of_month',
                'nb_days': 45,
            })]"/>
        </record>

        <record id="payment_term_acompte30_solde_reception" model="account.payment.term">
            <field name="name">Acompte 30 % à la commande, solde à réception</field>
            <field name="sequence">20</field>
            <field name="note">Acompte de 30 % à la signature du devis, solde à la
                réception des travaux.</field>
            <field name="line_ids" eval="[(5, 0, 0), (0, 0, {
                'value': 'percent',
                'value_amount': 30.0,
                'delay_type': 'days_after',
                'nb_days': 0,
            }), (0, 0, {
                'value': 'percent',
                'value_amount': 70.0,
                'delay_type': 'days_after',
                'nb_days': 0,
            })]"/>
        </record>

        <record id="payment_term_acompte30_solde_30j" model="account.payment.term">
            <field name="name">Acompte 30 % à la commande, solde à 30 jours</field>
            <field name="sequence">25</field>
            <field name="note">Acompte de 30 % à la signature du devis, solde à
                30 jours après la facture de travaux.</field>
            <field name="line_ids" eval="[(5, 0, 0), (0, 0, {
                'value': 'percent',
                'value_amount': 30.0,
                'delay_type': 'days_after',
                'nb_days': 0,
            }), (0, 0, {
                'value': 'percent',
                'value_amount': 70.0,
                'delay_type': 'days_after',
                'nb_days': 30,
            })]"/>
        </record>

    </data>
</odoo>
